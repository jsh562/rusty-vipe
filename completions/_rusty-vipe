#compdef rusty-vipe

autoload -U is-at-least

_rusty-vipe() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--suffix=[Tempfile filename suffix (default \`.txt\`). Editors use this as a syntax-highlighting hint]:SUFFIX:_default' \
'--editor=[Explicit editor override (Default mode only). Whitespace-aware (\`code --wait\` parses correctly)]:EDITOR:_default' \
'(--no-strict)--strict[Enable strict moreutils-compat mode]' \
'--no-strict[Explicitly disable strict mode (overrides env + argv\[0\])]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'::editor_extras -- Extra positional arguments forwarded to the editor (before the tempfile path):_default' \
":: :_rusty-vipe_commands" \
"*::: :->rusty-vipe" \
&& ret=0
    case $state in
    (rusty-vipe)
        words=($line[2] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rusty-vipe-command-$line[2]:"
        case $line[2] in
            (completions)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_rusty-vipe__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rusty-vipe-help-command-$line[1]:"
        case $line[1] in
            (completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_rusty-vipe_commands] )) ||
_rusty-vipe_commands() {
    local commands; commands=(
'completions:Emit shell completion scripts (Default mode only)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'rusty-vipe commands' commands "$@"
}
(( $+functions[_rusty-vipe__subcmd__completions_commands] )) ||
_rusty-vipe__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'rusty-vipe completions commands' commands "$@"
}
(( $+functions[_rusty-vipe__subcmd__help_commands] )) ||
_rusty-vipe__subcmd__help_commands() {
    local commands; commands=(
'completions:Emit shell completion scripts (Default mode only)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'rusty-vipe help commands' commands "$@"
}
(( $+functions[_rusty-vipe__subcmd__help__subcmd__completions_commands] )) ||
_rusty-vipe__subcmd__help__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'rusty-vipe help completions commands' commands "$@"
}
(( $+functions[_rusty-vipe__subcmd__help__subcmd__help_commands] )) ||
_rusty-vipe__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'rusty-vipe help help commands' commands "$@"
}

if [ "$funcstack[1]" = "_rusty-vipe" ]; then
    _rusty-vipe "$@"
else
    compdef _rusty-vipe rusty-vipe
fi
